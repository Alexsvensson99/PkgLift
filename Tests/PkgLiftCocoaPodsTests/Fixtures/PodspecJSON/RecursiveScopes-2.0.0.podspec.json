{
  "name": "Example",
  "version": "2.0.0",
  "platforms": {
    "ios": "14.0",
    "visionos": "1.0"
  },
  "dependencies": {
    "Zeta": [],
    "Alpha/Core": [
      "~> 1.0",
      "< 2.0"
    ]
  },
  "ios": {
    "source_files": "Sources/iOS/**/*.swift",
    "dependencies": {
      "UIKitHelper": [
        ">= 3.0"
      ]
    }
  },
  "default_subspecs": [
    "Core/Networking",
    "UI"
  ],
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Sources/Core/**/*.swift",
      "subspecs": [
        {
          "name": "Networking",
          "dependencies": {
            "Transport": [
              "~> 4.1"
            ]
          },
          "watchos": {
            "resources": [
              "Resources/Watch.json"
            ],
            "dependencies": {
              "WatchTransport": []
            }
          }
        }
      ]
    },
    {
      "name": "UI",
      "dependencies": {
        "Example/Core/Networking": []
      }
    }
  ]
}
